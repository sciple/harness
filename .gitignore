# Runtime state — generated by the harness, not committed
# (data/, workspace/ and their subdirs are auto-created at runtime)
data/
workspace/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Environment
.env
*.env

# Local Claude Code settings (machine-specific paths, personal allowlist)
.claude/

# Stale atomic-write temp files (session.save writes *.tmp then os.replace)
*.tmp

# Editor / OS
.DS_Store
Thumbs.db
